# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=4010
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# Database
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=backblog
# Opcional: use "require" para conexao SSL com Postgres gerenciado
PGSSLMODE=disable

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Auth/session
SESSION_EXPIRATION_HOURS=12
REFRESH_TOKEN_DAYS=30
SESSION_COOKIE_NAME=backblog.sid
REFRESH_COOKIE_NAME=backblog.refresh
# strict | lax | none
COOKIE_SAME_SITE=lax
# true | false (vazio = auto por ambiente/protocolo)
COOKIE_SECURE=
CSRF_COOKIE_NAME=backblog.csrf
CSRF_COOKIE_MAX_AGE_MS=86400000
CSRF_ENFORCE_ORIGIN=true
GOOGLE_CLIENT_ID=your_google_client_id_here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Auth security (rate limit + brute force)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=30
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_BRUTE_FORCE_WINDOW_MS=900000
AUTH_BRUTE_FORCE_MAX_FAILURES_PER_IP=20
AUTH_BRUTE_FORCE_MAX_FAILURES_PER_EMAIL=8
AUTH_BRUTE_FORCE_BLOCK_DURATION_MS=1800000
PUBLIC_LIKE_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_LIKE_RATE_LIMIT_MAX=20
PUBLIC_COMMENT_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_COMMENT_RATE_LIMIT_MAX=10
ADMIN_UPLOAD_RATE_LIMIT_WINDOW_MS=60000
ADMIN_UPLOAD_RATE_LIMIT_MAX=20

# Upload security
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880
UPLOAD_ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Storage
STORAGE_ROOT=./blog/storage
STORAGE_PUBLIC_ROOT=./blog/storage
STORAGE_PRIVATE_ROOT=./blog/storage_private

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1200
OPENAI_TEMPERATURE=0.7
OPENAI_DAILY_LIMIT_DEFAULT=20

# SMTP (envio transacional por no-reply)
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true para porta 465 (TLS implícito), false para 587 (STARTTLS)
SMTP_SECURE=false
# true para desativar STARTTLS quando seu relay exigir conexão sem upgrade
SMTP_IGNORE_TLS=false
# false para ignorar validação de certificado (use apenas em casos controlados)
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=no-reply@example.com
SMTP_PASS=change-me-mail-password
MAIL_FROM_NO_REPLY="Backblog <no-reply@example.com>"
MAIL_REPLY_TO="support@example.com"
